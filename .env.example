# Injected automatically at deploy time by NoCoder.
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

# Cuenta del dueño que crea el seed en cada base nueva.
# SIN ESTO el deploy crea el administrador con el correo y la contraseña por
# defecto del seed, que cualquiera que lea el repositorio conoce.
# Definilas en las variables del deploy ANTES de publicar.
# ADMIN_EMAIL="tu-correo@ejemplo.com"
# ADMIN_PASSWORD="una-contraseña-larga-y-propia"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Opcional: envío automático del aviso de reservas por WhatsApp (API Cloud de Meta).
# Sin estas dos variables, las reservas igual se registran y el aviso se puede
# enviar a mano desde el panel de administración. Sirven también para los avisos
# automáticos "volvió este perfume" y "recordatorio de reposición".
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Opcional: correo de los avisos automáticos. Resend (clave empieza con re_) o
# Brevo. También se puede pegar en Administración → Avisos automáticos y queda
# guardado en la base, sin volver a publicar.
# RESEND_API_KEY=""
# BREVO_API_KEY=""
# EMAIL_FROM="Mist & Mood <avisos@tudominio.com>"

# Opcional: protege el trabajo automático de /api/cron/outbox. Si lo definís,
# solo Vercel (o un administrador logueado) puede ejecutarlo.
# CRON_SECRET=""

# Opcional: claves de los avisos push (notificaciones de reservas en el móvil).
# NO hacen falta: se generan solas la primera vez que un administrador pulsa
# "Activar avisos" en el panel y se guardan en la base de datos.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:tu-correo@ejemplo.com"

# Opcional: modelo de lenguaje del asistente del chat.
# La forma más simple es pegar la clave en Administración → Asistente IA: se
# guarda en la base de datos y no hace falta volver a publicar. Si preferís
# fijarla en el servidor, descomentá UNA de estas líneas.
# Ojo: OpenRouter ya no tiene modelos ":free" con esta clave; usa los de
# centavos que vienen elegidos por defecto (gastan fracciones de centavo por
# conversación). Groq y Gemini siguen teniendo plan gratuito.
# GROQ_API_KEY=""        # https://console.groq.com/keys
# GEMINI_API_KEY=""      # https://aistudio.google.com/apikey
# OPENROUTER_API_KEY=""  # https://openrouter.ai/keys
