{
  "name": "tienda-de-perfumes",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && node scripts/db-repair.mjs && node scripts/db-prepare.mjs && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "deploy:supabase": "node scripts/deploy-supabase.mjs",
    "db:seed": "prisma db seed",
    "seed": "tsx prisma/seed.ts",
    "test:regression": "node scripts/regression.mjs",
    "db:reset": "node scripts/reset-db.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@prisma/client": "5.18.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "jsonwebtoken": "9.0.2",
    "leaflet": "^1.9.4",
    "next": "14.2.32",
    "pdfkit": "^0.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "web-push": "^4.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/leaflet": "^1.9.12",
    "@types/node": "20.14.10",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.41",
    "prisma": "5.18.0",
    "tailwindcss": "3.4.10",
    "tsx": "^4.19.2",
    "typescript": "5.5.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
