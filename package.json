{
  "name": "tienda-de-perfumes",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "postinstall": "node scripts/patch-fontkit.mjs && prisma generate",
    "db:push": "prisma db push",
    "db:export:supabase": "tsx scripts/export-supabase-data.ts",
    "db:import:build": "tsx scripts/build-d1-import-sql.ts",
    "db:migrate:local": "wrangler d1 migrations apply tienda-perfumes-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tienda-perfumes-db --remote",
    "db:seed:admin:ci": "node scripts/seed-admin-d1.mjs",
    "test:regression": "node scripts/regression.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "npm run build:worker && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "@phosphor-icons/react": "2.1.10",
    "@prisma/adapter-d1": "5.18.0",
    "@prisma/client": "5.18.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "jsonwebtoken": "9.0.2",
    "leaflet": "^1.9.4",
    "next": "15.5.29",
    "pdfkit": "^0.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/leaflet": "^1.9.12",
    "@types/node": "20.14.10",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.33",
    "prisma": "5.18.0",
    "tailwindcss": "3.4.10",
    "tsx": "^4.19.2",
    "typescript": "5.5.4",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "postcss": "8.5.33",
    "glob": "14.0.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "prisma": {
    "seed": "node -e \"console.log('Seed desactivado: la base de producción ya tiene los datos reales. No se cargan datos de ejemplo.')\""
  }
}
